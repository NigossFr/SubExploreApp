# SubExplore Supabase Environment Variables
# Copy this file to .env.supabase and fill in your actual values
# NEVER commit .env.supabase files to version control

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database Configuration (Direct PostgreSQL connection)
SUPABASE_DB_HOST=db.your-project-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_secure_database_password

# Connection Pool Settings
SUPABASE_DB_TIMEOUT=30
SUPABASE_DB_COMMAND_TIMEOUT=30
SUPABASE_DB_CONNECTION_IDLE_LIFETIME=300
SUPABASE_DB_MIN_POOL_SIZE=1
SUPABASE_DB_MAX_POOL_SIZE=10

# SSL Configuration
SUPABASE_SSL_MODE=Require
SUPABASE_TRUST_SERVER_CERTIFICATE=true

# Development Settings (remove in production)
SUPABASE_ENABLE_DEBUG_LOGGING=true
SUPABASE_LOG_SENSITIVE_DATA=false