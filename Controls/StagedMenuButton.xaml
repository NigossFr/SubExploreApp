<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SubExplore.Controls.StagedMenuButton"
             x:Name="Root"
             AutomationProperties.IsInAccessibleTree="True">
    
    <Frame x:Name="ButtonFrame"
           BackgroundColor="Transparent"
           BorderColor="Transparent"
           Padding="15,10"
           Margin="5,2"
           CornerRadius="8"
           HasShadow="False"
           AutomationProperties.IsInAccessibleTree="True"
           SemanticProperties.Hint="Menu button"
           SemanticProperties.Description="Tap to navigate"
           SemanticProperties.HeadingLevel="Level3">
        
        <!-- Simplified styling - removed complex triggers that may cause initialization issues -->
        
        <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnButtonTapped" />
        </Frame.GestureRecognizers>
        
        <Grid ColumnDefinitions="Auto,*,Auto">
            
            <!-- Icon/Stage Indicator -->
            <Frame Grid.Column="0"
                   x:Name="IconFrame"
                   BackgroundColor="Transparent"
                   BorderColor="Transparent"
                   Padding="0"
                   WidthRequest="24"
                   HeightRequest="24"
                   CornerRadius="12"
                   HasShadow="False"
                   IsVisible="False">
                
                                   <Image x:Name="IconImage"
                       Source="{Binding Source={x:Reference Root}, Path=Icon}"
                       WidthRequest="24"
                       HeightRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Aspect="AspectFit"
                       AutomationProperties.IsInAccessibleTree="False"
                       SemanticProperties.Description="Icon" />
                       
                <!-- Simplified icon styling -->
            </Frame>
            
            <!-- Content -->
            <StackLayout Grid.Column="1"
                        Margin="10,0,10,0"
                        VerticalOptions="Center">
                
                <!-- Title -->
                <Label x:Name="TitleLabel"
                       Text="{Binding Source={x:Reference Root}, Path=Title}"
                       FontSize="16"
                       FontAttributes="None"
                       TextColor="{Binding Source={x:Reference Root}, Path=TitleColor}"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"
                       SemanticProperties.HeadingLevel="Level3">
                    <!-- Title color handled in code-behind -->
                </Label>
                       
                <!-- Description -->
                <Label x:Name="DescriptionLabel"
                       Text="{Binding Source={x:Reference Root}, Path=Description}"
                       FontSize="12"
                       TextColor="{Binding Source={x:Reference Root}, Path=DescriptionColor}"
                       VerticalOptions="Center"
                       IsVisible="{Binding Source={x:Reference Root}, Path=ShowDescription}"
                       AutomationProperties.IsInAccessibleTree="False">
                    <!-- Description color handled in code-behind -->
                </Label>
                       
                <!-- Badge/Stage Text -->
                <Frame BackgroundColor="Red"
                       BorderColor="Transparent"
                       Padding="6,2"
                       CornerRadius="8"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       HasShadow="False"
                       IsVisible="{Binding Source={x:Reference Root}, Path=ShowBadge}">
                    <Label x:Name="BadgeLabel"
                           Text="{Binding Source={x:Reference Root}, Path=BadgeText}"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False"
                           SemanticProperties.Description="Badge de notification" />
                </Frame>
                       
            </StackLayout>
            
            <!-- Stage Indicator/Arrow -->
            <Label Grid.Column="2"
                   x:Name="StageIndicatorLabel"
                   Text="{Binding Source={x:Reference Root}, Path=StageIndicator}"
                   FontSize="14"
                   TextColor="{Binding Source={x:Reference Root}, Path=StageIndicatorColor}"
                   VerticalOptions="Center"
                   IsVisible="{Binding Source={x:Reference Root}, Path=ShowStageIndicator}"
                   AutomationProperties.IsInAccessibleTree="False"
                   SemanticProperties.Description="Indicateur d'état">
                <!-- Stage indicator color handled in code-behind -->
            </Label>
                   
        </Grid>
    </Frame>
    
</ContentView>