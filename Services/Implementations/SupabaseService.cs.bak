// Services/Implementations/SupabaseService.cs
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.Logging;
using SubExplore.DataAccess;
using SubExplore.Services.Interfaces;
using NetTopologySuite.Geometries;
using NetTopologySuite;

namespace SubExplore.Services.Implementations
{
    public class SupabaseService : ISupabaseService
    {
        private readonly SubExploreDbContext _context;
        private readonly IConfiguration _configuration;
        private readonly ILogger<SupabaseService> _logger;
        private readonly GeometryFactory _geometryFactory;

        public SupabaseService(
            SubExploreDbContext context,
            IConfiguration configuration,
            ILogger<SupabaseService> logger)
        {
            _context = context;
            _configuration = configuration;
            _logger = logger;
            _geometryFactory = NtsGeometryServices.Instance.CreateGeometryFactory(srid: 4326);
        }

        public async Task<bool> TestConnectionAsync()
        {
            try
            {
                _logger.LogInformation("Test de connexion à Supabase...");
                
                // Test simple de connexion
                var canConnect = await _context.Database.CanConnectAsync();
                
                if (canConnect)
                {
                    // Test avec une requête simple
                    var spotTypesCount = await _context.SpotTypes.CountAsync();
                    _logger.LogInformation("Connexion Supabase réussie. {Count} types de spots trouvés.", spotTypesCount);
                }
                
                return canConnect;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Erreur lors du test de connexion Supabase");
                return false;
            }
        }

        public async Task<IEnumerable<SubExplore.Models.Domain.Spot>> FindSpotsNearLocationAsync(
            double latitude, 
            double longitude, 
            int radiusKm = 50)
        {
            try
            {
                _logger.LogInformation("Recherche de spots près de {Lat}, {Lng} dans un rayon de {Radius}km", 
                    latitude, longitude, radiusKm);

                // Création du point de recherche
                var searchPoint = _geometryFactory.CreatePoint(new Coordinate(longitude, latitude));

                // Requête PostGIS pour trouver les spots dans le rayon
                var spots = await _context.Spots
                    .Include(s => s.Type)
                    .Include(s => s.Creator)
                    .Where(s => s.ValidationStatus == SubExplore.Models.Enums.SpotValidationStatus.Approved)
                    .Where(s => s.Location != null && s.Location.IsWithinDistance(searchPoint, radiusKm * 1000))
                    .OrderBy(s => s.Location!.Distance(searchPoint))
                    .Take(50)
                    .ToListAsync();

                _logger.LogInformation("Trouvé {Count} spots dans le rayon spécifié", spots.Count);
                return spots;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Erreur lors de la recherche de spots par proximité");
                return Enumerable.Empty<SubExplore.Models.Domain.Spot>();
            }
        }

        public async Task<string> UploadFileAsync(Stream fileStream, string fileName, string bucket = "spot-media")
        {
            try
            {
                // Note: Pour un upload complet vers Supabase Storage, 
                // il faudrait utiliser le SDK Supabase-csharp
                // Ici on simule le processus pour l'exemple
                
                _logger.LogInformation("Upload de fichier {FileName} vers le bucket {Bucket}", fileName, bucket);
                
                // Dans une implémentation complète, vous utiliseriez :
                // var supabase = new Supabase.Client(url, key);
                // var result = await supabase.Storage.From(bucket).Upload(fileStream, fileName);
                
                // Pour l'instant, retournons une URL simulée
                var baseUrl = _configuration["Supabase:Url"];
                return $"{baseUrl}/storage/v1/object/public/{bucket}/{fileName}";
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Erreur lors de l'upload du fichier {FileName}", fileName);
                throw;
            }
        }

        public async Task<bool> DeleteFileAsync(string fileName, string bucket = "spot-media")
        {
            try
            {
                _logger.LogInformation("Suppression du fichier {FileName} du bucket {Bucket}", fileName, bucket);
                
                // Implémentation similaire à l'upload
                // var supabase = new Supabase.Client(url, key);
                // await supabase.Storage.From(bucket).Remove(fileName);
                
                return true;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Erreur lors de la suppression du fichier {FileName}", fileName);
                return false;
            }
        }

        public async Task<SubExplore.Models.Domain.User?> GetUserByEmailAsync(string email)
        {
            try
            {
                return await _context.Users
                    .Include(u => u.Preferences)
                    .FirstOrDefaultAsync(u => u.Email == email);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Erreur lors de la récupération de l'utilisateur par email {Email}", email);
                return null;
            }
        }

        public async Task<bool> IsEmailTakenAsync(string email)
        {
            try
            {
                return await _context.Users.AnyAsync(u => u.Email == email);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Erreur lors de la vérification de l'email {Email}", email);
                return true; // Par sécurité, on assume que l'email est pris en cas d'erreur
            }
        }
    }
}