<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SubExplore.Views.Map.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:SubExplore.Helpers.Converters"
    xmlns:viewmodels="clr-namespace:SubExplore.ViewModels.Map"
    xmlns:common="clr-namespace:SubExplore.Views.Common"
    xmlns:components="clr-namespace:SubExplore.Views.Components"
    xmlns:controls="clr-namespace:SubExplore.Views.Controls"
    xmlns:domain="clr-namespace:SubExplore.Models.Domain"
    x:DataType="viewmodels:MapViewModel"
    Title="Carte"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
    
    
    <ContentPage.Resources>
        <converters:ResponsiveMarginConverter x:Key="ResponsiveMarginConverter" />
        <converters:ResponsiveFontSizeConverter x:Key="ResponsiveFontSizeConverter" />
        <converters:ResponsiveHeightConverter x:Key="ResponsiveHeightConverter" />
        <converters:SpotToLocationConverter x:Key="SpotToLocationConverter" />
    </ContentPage.Resources>


    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding InitializeMapCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <Grid>
        <!-- Custom Navigation Bar - GUARANTEED VISIBLE FLYOUT BUTTON -->
        <controls:CustomNavigationBar x:Name="CustomNavBar"
                                      Title="Carte"
                                      VerticalOptions="Start"
                                      ZIndex="100"
                                      HamburgerClicked="OnCustomHamburgerClicked" />
        
        <!-- Main Content - properly spaced with custom navigation bar -->
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,56,0,0">
        
        <!-- Enhanced Search Bar with Suggestions -->
        <StackLayout Grid.Row="0" Margin="0,8,0,8">
            <!-- Main Search Frame -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                   BorderColor="{StaticResource Primary}"
                   CornerRadius="25"
                   Padding="8"
                   HasShadow="True"
                   Margin="12,8,12,4"
                   AutomationId="SearchFrame"
                   SemanticProperties.Description="Zone de recherche de spots améliorée">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Entry Grid.Column="0"
                           x:Name="SearchEntry"
                           Margin="5,0"
                           ClearButtonVisibility="WhileEditing"
                           Placeholder="Rechercher un spot, lieu ou type..."
                           ReturnCommand="{Binding SearchSpotsCommand}"
                           ReturnType="Search"
                           Text="{Binding SearchText}"
                           FontSize="{Binding Source={x:Static Device.RuntimePlatform}, Converter={StaticResource ResponsiveFontSizeConverter}, ConverterParameter='1.0'}"
                           IsEnabled="{Binding IsSearching, Converter={StaticResource InvertBoolConverter}}"
                           AutomationId="SearchEntry"
                           SemanticProperties.Description="Rechercher des spots de plongée par nom, localisation ou type"
                           SemanticProperties.Hint="Entrez le nom d'un spot, d'une localisation ou d'un type d'activité">
                        <Entry.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="TextChanged" Command="{Binding SearchTextChangedCommand}" />
                        </Entry.Behaviors>
                    </Entry>
                    
                    <!-- Clear Button -->
                    <Button Grid.Column="1"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource ButtonActionStyle}"
                            Text="✕"
                            FontSize="14"
                            WidthRequest="35"
                            HeightRequest="35"
                            CornerRadius="17"
                            Padding="0"
                            IsVisible="{Binding SearchText, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                            AutomationId="ClearSearchButton"
                            SemanticProperties.Description="Effacer la recherche"
                            SemanticProperties.Hint="Appuyez pour effacer le texte de recherche" />
                    
                    <!-- Search Button -->
                    <Button Grid.Column="2"
                            Command="{Binding SearchSpotsCommand}"
                            Style="{StaticResource ButtonActionStyle}"
                            Text="🔍"
                            FontSize="16"
                            WidthRequest="40"
                            HeightRequest="35"
                            IsEnabled="{Binding IsSearching, Converter={StaticResource InvertBoolConverter}}"
                            AutomationId="SearchButton"
                            SemanticProperties.Description="Lancer la recherche de spots"
                            SemanticProperties.Hint="Appuyez pour rechercher des spots correspondant au texte saisi">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Text" Value="⏳" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Frame>
            
            <!-- Search Suggestions Dropdown -->
            <Frame IsVisible="{Binding AreSuggestionsVisible}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                   BorderColor="{StaticResource Gray200}"
                   CornerRadius="15"
                   Padding="8"
                   HasShadow="True"
                   Margin="15,0,15,5"
                   AutomationId="SuggestionsFrame"
                   SemanticProperties.Description="Suggestions de recherche">
                <CollectionView ItemsSource="{Binding SearchSuggestions}"
                                SelectionMode="None"
                                VerticalOptions="Start"
                                AutomationId="SuggestionsList"
                                SemanticProperties.Description="Liste des suggestions de recherche">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:String}">
                            <Grid Padding="8,4">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MapViewModel}}, Path=SelectSuggestionCommand}"
                                                         CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="🔍"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray500}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation" />
                                </StackLayout>
                                
                                <!-- Hover Effect -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter TargetName="SuggestionFrame" Property="BackgroundColor" Value="{StaticResource Gray100}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>
        </StackLayout>
        
        <RefreshView Grid.Row="1" Command="{Binding LoadSpotsCommand}" IsRefreshing="{Binding IsBusy}">
            <Grid RowDefinitions="Auto,400,Auto">
                
                <!-- Nouvelle organisation des filtres : 4 boutons principaux + sous-filtres -->
                <StackLayout Grid.Row="0"
                           Margin="12,4,12,8">
                    
                    <!-- Boutons de catégories principales (4 boutons sur toute la largeur) -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        
                        <!-- Bouton Tous -->
                        <Button Grid.Column="0"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource ButtonFilterStyle}"
                                Text="Tous"
                                FontSize="{Binding Source={x:Static Device.RuntimePlatform}, Converter={StaticResource ResponsiveFontSizeConverter}, ConverterParameter='0.85'}"
                                CornerRadius="8"
                                Padding="8,8"
                                AutomationId="ClearFiltersButton"
                                SemanticProperties.Description="Afficher tous les types de spots">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="{x:Null}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- Bouton Activités -->
                        <Button Grid.Column="1"
                                Command="{Binding FilterByCategoryCommand}"
                                CommandParameter="Activités"
                                Style="{StaticResource ButtonFilterStyle}"
                                Text="Activités"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FilterActivities}, Dark={StaticResource FilterActivitiesDark}}"
                                TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                                FontSize="{Binding Source={x:Static Device.RuntimePlatform}, Converter={StaticResource ResponsiveFontSizeConverter}, ConverterParameter='0.85'}"
                                CornerRadius="8"
                                Padding="8,8"
                                AutomationId="ActivitiesFilterButton"
                                SemanticProperties.Description="Filtrer par activités sous-marines">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="Activités">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Opacity" Value="0.8" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- Bouton Structures -->
                        <Button Grid.Column="2"
                                Command="{Binding FilterByCategoryCommand}"
                                CommandParameter="Structures"
                                Style="{StaticResource ButtonFilterStyle}"
                                Text="Structures"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FilterStructures}, Dark={StaticResource FilterStructuresDark}}"
                                TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                                FontSize="{Binding Source={x:Static Device.RuntimePlatform}, Converter={StaticResource ResponsiveFontSizeConverter}, ConverterParameter='0.85'}"
                                CornerRadius="8"
                                Padding="8,8"
                                AutomationId="StructuresFilterButton"
                                SemanticProperties.Description="Filtrer par structures et organisations">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="Structures">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Opacity" Value="0.8" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- Bouton Boutiques -->
                        <Button Grid.Column="3"
                                Command="{Binding FilterByCategoryCommand}"
                                CommandParameter="Boutiques"
                                Style="{StaticResource ButtonFilterStyle}"
                                Text="Boutiques"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FilterShops}, Dark={StaticResource FilterShopsDark}}"
                                TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                                FontSize="{Binding Source={x:Static Device.RuntimePlatform}, Converter={StaticResource ResponsiveFontSizeConverter}, ConverterParameter='0.85'}"
                                CornerRadius="8"
                                Padding="8,8"
                                AutomationId="ShopsFilterButton"
                                SemanticProperties.Description="Filtrer par boutiques et magasins">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="Boutiques">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Opacity" Value="0.8" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    
                    <!-- Indicateur de filtrage actif -->
                    <Frame IsVisible="{Binding IsAnyFilterActive}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource Info}}"
                           BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           CornerRadius="8"
                           Padding="12,8"
                           HasShadow="False"
                           Margin="0,8,0,4"
                           AutomationId="FilterStatusFrame">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0"
                                   Text="🔍"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Grid.Column="1"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   FontAttributes="Bold"
                                   Margin="8,0,0,0">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} spot(s) affiché(s)">
                                        <Binding Path="FilteredSpotsCount" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Button Grid.Column="2"
                                    Text="Effacer"
                                    FontSize="12"
                                    BackgroundColor="{AppThemeBinding Light=#FF5722, Dark=#D32F2F}"
                                    TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Command="{Binding ClearFiltersCommand}"
                                    AutomationId="ClearActiveFiltersButton" />
                        </Grid>
                    </Frame>
                    
                    <!-- Menu de sous-filtres (visible uniquement si une catégorie est sélectionnée) -->
                    <Frame IsVisible="{Binding IsSubFiltersVisible}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                           BorderColor="{StaticResource Gray200}"
                           CornerRadius="12"
                           Padding="8"
                           HasShadow="True"
                           Margin="0,4,0,0"
                           AutomationId="SubFiltersFrame">
                        
                        <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                            <CollectionView ItemsSource="{Binding CurrentSubFilters}"
                                            SelectionMode="None"
                                            AutomationId="SubFiltersList">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:SpotType">
                                        <Button BackgroundColor="{Binding ColorCode}"
                                                Style="{StaticResource ButtonFilterStyle}"
                                                Text="{Binding Name}"
                                                TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                                                FontSize="{Binding Source={x:Static Device.RuntimePlatform}, Converter={StaticResource ResponsiveFontSizeConverter}, ConverterParameter='0.8'}"
                                                CornerRadius="8"
                                                Padding="12,6"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MapViewModel}}, Path=FilterSpotsByTypeCommand}"
                                                CommandParameter="{Binding .}"
                                                AutomationId="{Binding Name, StringFormat='SubFilter{0}Button'}"
                                                SemanticProperties.Description="{Binding Name, StringFormat='Filtrer par {0}'}">
                                            <Button.Triggers>
                                                <!-- Visual feedback when this filter is active -->
                                                <DataTrigger TargetType="Button" Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MapViewModel}}, Path=SelectedSpotType.Id}" Value="{Binding Id}">
                                                    <Setter Property="BorderColor" Value="{AppThemeBinding Light=#FFDD00, Dark=#FFF176}" />
                                                    <Setter Property="BorderWidth" Value="3" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Scale" Value="1.05" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                    </Frame>
                </StackLayout>

        <!--  Carte responsive avec hauteur fixe  -->
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Frame CornerRadius="15" HasShadow="True" Padding="0">
                <maps:Map
                    x:Name="MainMap"
                    IsShowingUser="{Binding IsLocationAvailable}"
                    MapClicked="OnMapClicked"
                    MapType="Street"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    IsZoomEnabled="True"
                    IsScrollEnabled="True"
                    AutomationId="MainMap"
                    SemanticProperties.Description="Carte interactive des spots de plongée"
                    SemanticProperties.Hint="Explorez les spots de plongée sur la carte, cliquez près d'un marqueur pour voir les détails">
                
            <maps:Map.MapElements>
                <!--  Custom spot markers will be added programmatically in code-behind  -->
            </maps:Map.MapElements>
                </maps:Map>
            </Frame>
            
            
            <!--  État vide  -->
            <StackLayout
                IsVisible="{Binding IsEmptyState}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="10">
                <Label
                    Text=""
                    FontSize="48"
                    HorizontalOptions="Center" />
                <Label
                    Text="Aucun spot trouvé"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Center" />
                <Label
                    Text="Essayez d'ajuster vos filtres ou votre recherche"
                    Style="{StaticResource Caption}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />
            </StackLayout>
            
            <!--  État d'erreur réseau  -->
            <StackLayout
                IsVisible="{Binding IsNetworkError}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="10">
                <Label
                    Text=""
                    FontSize="48"
                    HorizontalOptions="Center" />
                <Label
                    Text="Connexion limitée"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Center" />
                <Button
                    Text="Réessayer"
                    Command="{Binding LoadSpotsCommand}"
                    Style="{StaticResource ButtonPrimaryStyle}"
                    HorizontalOptions="Center" />
            </StackLayout>
        </Grid>

        <!--  Barre d'actions simplifiée - Boutons colorés pleine largeur  -->
        <Grid 
            Grid.Row="2"
            ColumnDefinitions="*,*,*" 
            ColumnSpacing="8"
            Margin="8,8,8,16"
            AutomationId="ActionsGrid"
            SemanticProperties.Description="Barre d'actions principales de la carte">
            
            <!-- Button 1: Actualiser -->
            <Button
                Grid.Column="0"
                Command="{Binding LoadSpotsCommand}"
                Style="{StaticResource ButtonMapActionStyle}"
                Text="Actualiser"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                AutomationId="RefreshSpotsButton"
                SemanticProperties.Description="Actualiser les spots sur la carte"
                SemanticProperties.Hint="Appuyez pour recharger les spots depuis le serveur">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Text" Value="Actualiser..." />
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            
            <!-- Button 2: Ma position -->
            <Button
                Grid.Column="1"
                Command="{Binding RefreshLocationCommand}"
                Style="{StaticResource ButtonMapActionStyle}"
                Text="Localiser"
                AutomationId="MyLocationButton"
                SemanticProperties.Description="Centrer la carte sur ma position actuelle"
                SemanticProperties.Hint="Appuyez pour obtenir votre position GPS et centrer la carte">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsLocationAvailable}" Value="True">
                        <Setter Property="Text" Value="Ma position" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsLocationAvailable}" Value="False">
                        <Setter Property="Text" Value="Localiser" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            
            <!-- Button 3: Nouveau spot -->
            <Button
                Grid.Column="2"
                Command="{Binding NavigateToAddSpotCommand}"
                Style="{StaticResource ButtonMapActionStyle}"
                Text="Nouveau"
                AutomationId="AddSpotButton"
                SemanticProperties.Description="Ajouter un nouveau spot de plongée"
                SemanticProperties.Hint="Appuyez pour commencer l'ajout d'un nouveau spot" />
        </Grid>

            </Grid>
        </RefreshView>
        
            <!--  Indicateur de chargement amélioré  -->
            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                IsVisible="{Binding IsBusy}"
                BackgroundColor="{AppThemeBinding Light={StaticResource ModalOverlay}, Dark={StaticResource ModalOverlayDark}}"
                AutomationId="LoadingOverlay">
            <Frame
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                CornerRadius="15"
                Padding="20"
                HasShadow="True">
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource Primary}"
                        AutomationId="LoadingIndicator" />
                    <Label
                        Text="Chargement..."
                        VerticalOptions="Center"
                        Style="{StaticResource BodyText}"
                        SemanticProperties.Description="Chargement des données en cours"
                        SemanticProperties.Hint="Veuillez patienter pendant le chargement des spots" />
                </StackLayout>
            </Frame>
        </Grid>
        </Grid>
        
        <!-- Custom Spot Window - Shows spot info with details button -->
        <Frame x:Name="SpotMiniWindow"
               IsVisible="{Binding IsSpotMiniWindowVisible}"
               BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
               BorderColor="{StaticResource Primary}"
               CornerRadius="15"
               Padding="15"
               HasShadow="True"
               VerticalOptions="End"
               HorizontalOptions="Center"
               Margin="20,0,20,80"
               WidthRequest="300"
               HeightRequest="200"
               InputTransparent="False"
               AutomationId="SpotMiniWindow"
               SemanticProperties.Description="Aperçu du spot sélectionné">
            
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <!-- Close Button -->
                <Button Grid.Row="0"
                        Text="✕"
                        FontSize="16"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextSecondary}"
                        Command="{Binding CloseSpotMiniWindowCommand}"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        WidthRequest="30"
                        HeightRequest="30"
                        CornerRadius="15"
                        Padding="0"
                        AutomationId="CloseMiniWindowButton"
                        SemanticProperties.Description="Fermer l'aperçu du spot" />
                
                <!-- Spot Name -->
                <Label Grid.Row="1"
                       Text="{Binding SelectedSpot.Name}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="2"
                       AutomationId="SpotNameLabel"
                       SemanticProperties.Description="Nom du spot" />
                
                <!-- Activity Type and Level -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0"
                           BackgroundColor="{Binding SelectedSpot.Type.ColorCode, FallbackValue={StaticResource Primary}}"
                           CornerRadius="8"
                           Padding="8,4"
                           HasShadow="False">
                        <Label Text="{Binding SelectedSpot.Type.Name, FallbackValue='Spot'}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation"
                               AutomationId="SpotTypeLabel"
                               SemanticProperties.Description="Type d'activité" />
                    </Frame>
                    
                    <Frame Grid.Column="1"
                           BackgroundColor="{StaticResource Secondary}"
                           CornerRadius="8"
                           Padding="8,4"
                           HasShadow="False">
                        <Label FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               AutomationId="SpotLevelLabel"
                               SemanticProperties.Description="Niveau de difficulté">
                            <Label.Text>
                                <MultiBinding StringFormat="Niveau {0}">
                                    <Binding Path="SelectedSpot.DifficultyLevel" Converter="{StaticResource DifficultyLevelToFrenchConverter}" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </Frame>
                </Grid>
                
                <!-- View Details Button -->
                <Button Grid.Row="3"
                        Text="Voir les détails"
                        Command="{Binding ViewSpotDetailsCommand}"
                        Style="{StaticResource ButtonPrimaryStyle}"
                        FontSize="14"
                        CornerRadius="8"
                        Padding="20,8"
                        Margin="0,5,0,0"
                        AutomationId="ViewDetailsButton"
                        SemanticProperties.Description="Voir tous les détails du spot"
                        SemanticProperties.Hint="Appuyez pour ouvrir la page de détails complète du spot" />
            </Grid>
        </Frame>
        
    </Grid>
</ContentPage>