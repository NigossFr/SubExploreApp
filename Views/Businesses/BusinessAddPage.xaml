<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SubExplore.Views.Businesses.BusinessAddPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:SubExplore.ViewModels.Businesses"
    x:DataType="viewmodels:BusinessAddViewModel"
    Title="Ajouter un Commerce"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <ScrollView>
        <StackLayout Padding="16" Spacing="12">

            <!-- Titre -->
            <Label
                Text="🛍️ Nouveau Commerce/Boutique"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="{StaticResource Primary}"
                HorizontalOptions="Center"
                Margin="0,0,0,16" />

            <!-- Message de validation -->
            <Frame
                IsVisible="{Binding HasValidationErrors}"
                BackgroundColor="{StaticResource Error}"
                BorderColor="{StaticResource Error}"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,8">
                <Label
                    Text="{Binding ValidationMessage}"
                    TextColor="White"
                    FontSize="14" />
            </Frame>

            <!-- Informations de base -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                   BorderColor="{StaticResource Primary}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True">
                <StackLayout Spacing="12">
                    <Label Text="📋 Informations de base"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <!-- Nom -->
                    <StackLayout>
                        <Label Text="Nom du commerce *" FontAttributes="Bold" />
                        <Entry Text="{Binding Name}"
                               Placeholder="Nom du commerce"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>

                    <!-- Type de commerce -->
                    <StackLayout>
                        <Label Text="Type de commerce *" FontAttributes="Bold" />
                        <Picker ItemsSource="{Binding BusinessTypes}"
                                SelectedItem="{Binding SelectedBusinessType}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>

                    <!-- Description -->
                    <StackLayout>
                        <Label Text="Description" FontAttributes="Bold" />
                        <Editor Text="{Binding Description}"
                                Placeholder="Décrivez votre commerce..."
                                HeightRequest="80"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Localisation -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                   BorderColor="{StaticResource Secondary}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True">
                <StackLayout Spacing="12">
                    <Label Text="📍 Localisation"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Secondary}" />

                    <!-- Coordonnées GPS -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackLayout Grid.Column="0">
                            <Label Text="Latitude" FontAttributes="Bold" />
                            <Entry Text="{Binding Latitude}"
                                   Keyboard="Numeric"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Label Text="Longitude" FontAttributes="Bold" />
                            <Entry Text="{Binding Longitude}"
                                   Keyboard="Numeric"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                        </StackLayout>
                    </Grid>

                    <!-- Bouton localisation -->
                    <Button Text="📍 Obtenir ma position"
                            Command="{Binding GetCurrentLocationCommand}"
                            IsEnabled="{Binding IsLocationLoading, Converter={StaticResource InvertBoolConverter}}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White" />

                    <!-- Adresse -->
                    <StackLayout>
                        <Label Text="Adresse *" FontAttributes="Bold" />
                        <Entry Text="{Binding Address}"
                               Placeholder="Adresse complète"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>

                    <!-- Ville et code postal -->
                    <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
                        <StackLayout Grid.Column="0">
                            <Label Text="Ville *" FontAttributes="Bold" />
                            <Entry Text="{Binding City}"
                                   Placeholder="Ville"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Label Text="Code postal" FontAttributes="Bold" />
                            <Entry Text="{Binding PostalCode}"
                                   Placeholder="00000"
                                   Keyboard="Numeric"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                        </StackLayout>
                    </Grid>

                    <!-- Pays -->
                    <StackLayout>
                        <Label Text="Pays" FontAttributes="Bold" />
                        <Entry Text="{Binding Country}"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Contact -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                   BorderColor="{StaticResource Accent}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True">
                <StackLayout Spacing="12">
                    <Label Text="📞 Contact"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Accent}" />

                    <!-- Téléphone -->
                    <StackLayout>
                        <Label Text="Téléphone" FontAttributes="Bold" />
                        <Entry Text="{Binding Phone}"
                               Placeholder="+33 1 23 45 67 89"
                               Keyboard="Telephone"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>

                    <!-- Email -->
                    <StackLayout>
                        <Label Text="Email" FontAttributes="Bold" />
                        <Entry Text="{Binding Email}"
                               Placeholder="contact@commerce.com"
                               Keyboard="Email"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>

                    <!-- Site web -->
                    <StackLayout>
                        <Label Text="Site web" FontAttributes="Bold" />
                        <Entry Text="{Binding Website}"
                               Placeholder="https://www.commerce.com"
                               Keyboard="Url"
                               BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Services et Commerce -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                   BorderColor="{StaticResource Success}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True">
                <StackLayout Spacing="12">
                    <Label Text="💰 Commerce et Services"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Success}" />

                    <!-- Services offerts -->
                    <StackLayout>
                        <Label Text="Services et produits" FontAttributes="Bold" />
                        <Editor Text="{Binding Services}"
                                Placeholder="Décrivez vos produits et services..."
                                HeightRequest="80"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>

                    <!-- Gamme de prix -->
                    <StackLayout>
                        <Label Text="Gamme de prix" FontAttributes="Bold" />
                        <Picker ItemsSource="{x:Array Type={x:Type x:String}}"
                                SelectedItem="{Binding PriceRange}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}">
                            <Picker.Items>
                                <x:String>€ (Économique)</x:String>
                                <x:String>€€ (Modéré)</x:String>
                                <x:String>€€€ (Élevé)</x:String>
                                <x:String>€€€€ (Luxe)</x:String>
                            </Picker.Items>
                        </Picker>
                    </StackLayout>

                    <!-- Méthodes de paiement -->
                    <StackLayout>
                        <Label Text="Méthodes de paiement acceptées *" FontAttributes="Bold" />

                        <FlexLayout BindableLayout.ItemsSource="{Binding AvailablePaymentMethods}"
                                    Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type x:String}">
                                    <StackLayout Orientation="Horizontal"
                                                 Spacing="4"
                                                 Margin="0,4,12,4">
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BusinessAddViewModel}}, Path=TogglePaymentMethodCommand}"
                                                CommandParameter="{Binding .}" />
                                        </StackLayout.GestureRecognizers>

                                        <CheckBox IsChecked="{Binding ., Converter={StaticResource PaymentMethodSelectedConverter}, ConverterParameter={Binding Source={RelativeSource AncestorType={x:Type viewmodels:BusinessAddViewModel}}, Path=PaymentMethods}}" />
                                        <Label Text="{Binding .}"
                                               VerticalOptions="Center"
                                               FontSize="14" />
                                    </StackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </StackLayout>

                    <!-- Horaires d'ouverture -->
                    <StackLayout>
                        <Label Text="Horaires d'ouverture" FontAttributes="Bold" />
                        <Editor Text="{Binding OperatingHours}"
                                Placeholder="Ex: Lun-Ven: 9h-18h, Sam: 9h-17h, Dim: fermé"
                                HeightRequest="60"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray600}}" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Boutons d'action -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button Grid.Column="0"
                        Text="Annuler"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource Gray400}"
                        TextColor="White" />

                <Button Grid.Column="1"
                        Text="Créer le commerce"
                        Command="{Binding SubmitBusinessCommand}"
                        IsEnabled="{Binding IsSubmitting, Converter={StaticResource InvertBoolConverter}}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White" />
            </Grid>

            <!-- Indicateur de chargement -->
            <ActivityIndicator IsRunning="{Binding IsSubmitting}"
                               IsVisible="{Binding IsSubmitting}"
                               Color="{StaticResource Primary}"
                               Margin="0,16,0,0" />

        </StackLayout>
    </ScrollView>
</ContentPage>