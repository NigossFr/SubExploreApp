<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SubExplore.Views.Spots.MySpotsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Mes spots">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            
            <!-- Header -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Mes Spots de Plongée"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Découvrez les spots que vous avez créés"
                           FontSize="14"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Opacity="0.9" />
                </VerticalStackLayout>
            </Frame>

            <!-- Content -->
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                   CornerRadius="15"
                   Padding="30"
                   HasShadow="True">
                <VerticalStackLayout Spacing="20">
                    
                    <!-- Info Icon -->
                    <Label Text="🏖️"
                           FontSize="60"
                           HorizontalOptions="Center" />
                    
                    <!-- Main message -->
                    <Label Text="Aucun spot créé"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                    
                    <Label Text="Vous n'avez pas encore créé de spots de plongée. Commencez par explorer la carte et ajouter vos propres découvertes !"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           HorizontalTextAlignment="Center" />

                    <!-- Action button -->
                    <Button Text="Explorer la carte"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="White"
                            CornerRadius="25"
                            Padding="20,10"
                            FontAttributes="Bold"
                            Clicked="OnExploreMapClicked"
                            HorizontalOptions="Center"
                            Margin="0,20,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Stats placeholder -->
            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                    
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="0" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Spots créés" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="0" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Validés" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                        <Label Text="0" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="En attente" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>
                    
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>