<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SubExplore.Views.Spots.SpotPhotosPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SubExplore.Views.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid>
        <!-- Custom Navigation Bar -->
        <controls:CustomNavigationBar Title="{Binding Title}" 
                                      VerticalOptions="Start"
                                      ZIndex="100" />

        <ScrollView Margin="0,56,0,0">
            <StackLayout Padding="20" Spacing="20">
                
                <!-- Loading State -->
                <Frame IsVisible="{Binding IsLoading}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource CardDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                       CornerRadius="12"
                       HasShadow="True">
                    <StackLayout Orientation="Horizontal" Spacing="15">
                        <ActivityIndicator IsRunning="True" 
                                         Color="{StaticResource Primary}" 
                                         VerticalOptions="Center" />
                        <Label Text="Chargement des photos..." 
                               VerticalOptions="Center"
                               FontSize="16" />
                    </StackLayout>
                </Frame>

                <!-- Upload Progress -->
                <Frame IsVisible="{Binding IsUploading}"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource CardDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                       CornerRadius="12" HasShadow="True" Padding="20">
                    <StackLayout Spacing="15">
                        <Label Text="📤 Upload en cours" 
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        
                        <ProgressBar Progress="{Binding UploadProgress}" 
                                     ProgressColor="{StaticResource Primary}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        
                        <Label Text="{Binding UploadStatus}" 
                               FontSize="14"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Frame>

                <!-- Photo Management Content -->
                <StackLayout IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" 
                           Spacing="15">

                    <!-- Add Photos Card -->
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource CardDark}}"
                           BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                           CornerRadius="12" HasShadow="True" Padding="20">
                        <StackLayout Spacing="15">
                            <Label Text="📸 Ajouter des Photos" 
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <Button Grid.Column="0"
                                        Text="📷 Appareil Photo"
                                        Command="{Binding AddPhotoFromCameraCommand}"
                                        BackgroundColor="{StaticResource Secondary}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        FontAttributes="Bold"
                                        IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}" />
                                
                                <Button Grid.Column="1"
                                        Text="🖼️ Galerie"
                                        Command="{Binding AddPhotoFromGalleryCommand}"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        CornerRadius="8"
                                        FontAttributes="Bold"
                                        IsEnabled="{Binding IsUploading, Converter={StaticResource InvertedBoolConverter}}" />
                            </Grid>
                        </StackLayout>
                    </Frame>

                    <!-- Photos Collection -->
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource CardDark}}"
                           BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                           CornerRadius="12" HasShadow="True" Padding="20">
                        <StackLayout Spacing="15">
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="🖼️ Photos du Spot" 
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       VerticalOptions="Center" />
                                
                                <Frame BackgroundColor="{StaticResource Success}"
                                       Padding="8,4"
                                       CornerRadius="12"
                                       HasShadow="False">
                                    <Label Text="{Binding SpotPhotos.Count}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                </Frame>
                            </StackLayout>

                            <!-- No Photos State -->
                            <StackLayout IsVisible="{Binding SpotPhotos.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                       Padding="20" Spacing="10">
                                <Label Text="📷"
                                       FontSize="48"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                <Label Text="Aucune photo pour ce spot"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                <Label Text="Utilisez les boutons ci-dessus pour ajouter des photos"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                            </StackLayout>

                            <!-- Photos Grid -->
                            <CollectionView ItemsSource="{Binding SpotPhotos}"
                                          ItemsLayout="VerticalGrid, 2"
                                          IsVisible="{Binding SpotPhotos.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                                               BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                               CornerRadius="12"
                                               HasShadow="True"
                                               Margin="5"
                                               Padding="0">
                                            <Grid>
                                                <!-- Photo Image -->
                                                <Image Source="{Binding MediaUrl}"
                                                       Aspect="AspectFill"
                                                       HeightRequest="150"
                                                       VerticalOptions="Fill"
                                                       HorizontalOptions="Fill" />
                                                
                                                <!-- Primary Badge -->
                                                <Frame IsVisible="{Binding IsPrimary}"
                                                       BackgroundColor="{StaticResource Warning}"
                                                       Padding="6,3"
                                                       CornerRadius="8"
                                                       HasShadow="False"
                                                       VerticalOptions="Start"
                                                       HorizontalOptions="Start"
                                                       Margin="8">
                                                    <Label Text="⭐ Principale"
                                                           TextColor="White"
                                                           FontAttributes="Bold"
                                                           FontSize="10" />
                                                </Frame>
                                                
                                                <!-- Action Buttons Overlay -->
                                                <StackLayout VerticalOptions="End"
                                                           HorizontalOptions="Fill"
                                                           BackgroundColor="#80000000"
                                                           Padding="8"
                                                           Spacing="0">
                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                                                        <!-- Set as Primary -->
                                                        <Button Grid.Column="0"
                                                                Text="⭐"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetAsPrimaryCommand}"
                                                                CommandParameter="{Binding .}"
                                                                BackgroundColor="{StaticResource Warning}"
                                                                TextColor="White"
                                                                FontSize="12"
                                                                Padding="4"
                                                                CornerRadius="4"
                                                                IsVisible="{Binding IsPrimary, Converter={StaticResource InvertedBoolConverter}}" />
                                                        
                                                        <!-- View Full Size -->
                                                        <Button Grid.Column="1"
                                                                Text="👁️"
                                                                BackgroundColor="{StaticResource Secondary}"
                                                                TextColor="White"
                                                                FontSize="12"
                                                                Padding="4"
                                                                CornerRadius="4" />
                                                        
                                                        <!-- Delete -->
                                                        <Button Grid.Column="2"
                                                                Text="🗑️"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeletePhotoCommand}"
                                                                CommandParameter="{Binding .}"
                                                                BackgroundColor="{StaticResource Danger}"
                                                                TextColor="White"
                                                                FontSize="12"
                                                                Padding="4"
                                                                CornerRadius="4" />
                                                    </Grid>
                                                </StackLayout>
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            
                            <!-- Photo Management Actions -->
                            <Button Text="🔄 Réorganiser les Photos"
                                    Command="{Binding ReorderPhotosCommand}"
                                    BackgroundColor="{StaticResource Info}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    FontAttributes="Bold"
                                    IsVisible="{Binding SpotPhotos.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}" />
                        </StackLayout>
                    </Frame>

                </StackLayout>

                <!-- Error State -->
                <Frame IsVisible="{Binding IsError}"
                       BackgroundColor="{StaticResource Danger}"
                       BorderColor="{StaticResource Danger}"
                       CornerRadius="12" HasShadow="True" Padding="20">
                    <StackLayout Spacing="10">
                        <Label Text="❌ Erreur"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="White"
                               FontSize="14" />
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Toast Notification -->
        <Frame IsVisible="{Binding IsToastVisible}"
               BackgroundColor="{Binding ToastBackgroundColor}"
               BorderColor="{Binding ToastBorderColor}"
               CornerRadius="25"
               Padding="15,10"
               Margin="20"
               VerticalOptions="End"
               HorizontalOptions="Center"
               HasShadow="True"
               ZIndex="999">
            <Label Text="{Binding ToastMessage}"
                   TextColor="{Binding ToastTextColor}"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
        </Frame>

    </Grid>
</ContentPage>