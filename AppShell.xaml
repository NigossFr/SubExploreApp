<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SubExplore.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SubExplore"
    xmlns:map="clr-namespace:SubExplore.Views.Map"
    xmlns:spots="clr-namespace:SubExplore.Views.Spots"
    xmlns:favorites="clr-namespace:SubExplore.Views.Favorites"
    xmlns:profile="clr-namespace:SubExplore.Views.Profile"
    xmlns:admin="clr-namespace:SubExplore.Views.Admin"
    xmlns:auth="clr-namespace:SubExplore.Views.Auth"
    xmlns:settings="clr-namespace:SubExplore.Views.Settings"
    xmlns:controls="clr-namespace:SubExplore.Controls"
    xmlns:viewmodels="clr-namespace:SubExplore.ViewModels"
    xmlns:converters="clr-namespace:SubExplore.Helpers.Converters"
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="White" 
    Shell.ForegroundColor="Black"
    Shell.TitleColor="Black"
    FlyoutIcon="hamburger_menu.svg"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
    FlyoutHeaderBehavior="CollapseOnScroll"
    Title="SubExplore"
    x:Name="AppShellRoot">
    
    <Shell.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BooleanMultiValueConverter x:Key="BooleanMultiValueConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Enhanced Flyout Header Template -->
    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <Frame BackgroundColor="{StaticResource Primary}"
                   HeightRequest="200"
                   HasShadow="False"
                   Margin="0">
                <Grid ColumnDefinitions="Auto,*,60">

                    <!-- App Logo/Icon -->
                    <Frame Grid.Column="0"
                           BackgroundColor="White"
                           CornerRadius="25"
                           WidthRequest="50"
                           HeightRequest="50"
                           Padding="10"
                           VerticalOptions="Center">
                        <Image Source="dotnet_bot.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Frame>

                    <!-- User Info -->
                    <StackLayout Grid.Column="1"
                               Margin="15,0,15,0"
                               VerticalOptions="Center">
                        <Label x:Name="UserNameLabel"
                               Text="Utilisateur SubExplore"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Explorateur sous-marin"
                               FontSize="14"
                               TextColor="White"
                               Opacity="0.8" />
                    </StackLayout>

                    <!-- User Avatar -->
                    <Frame Grid.Column="2"
                           BackgroundColor="White"
                           CornerRadius="30"
                           WidthRequest="60"
                           HeightRequest="60"
                           Padding="0"
                           VerticalOptions="Center">
                        <Label Text="👤"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Frame>
                </Grid>
            </Frame>
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>

    <!-- Custom Flyout Content Template - Original Design -->
    <Shell.FlyoutContentTemplate>
        <DataTemplate>
            <ScrollView BackgroundColor="{StaticResource Background}">
                <StackLayout Spacing="0">
                    
                    <!-- Navigation Section -->
                    <Label Text="Navigation"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="15,15,15,5" />
                    
                    <!-- Carte -->
                    <Frame BackgroundColor="Transparent"
                           BorderColor="Transparent"
                           Padding="15,10"
                           Margin="5,2"
                           CornerRadius="8"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToMap" />
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="40,*">
                            <Label Grid.Column="0"
                                   Text="🗺️"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            
                            <StackLayout Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalOptions="Center">
                                <Label Text="Carte"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Text="Explorer les spots de plongée"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>
                    </Frame>
                    
                    <!-- Mes Spots Section -->
                    <Label Text="Mes Spots"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="15,15,15,5" />
                    
                    <!-- Mes Spots -->
                    <Frame BackgroundColor="Transparent"
                           BorderColor="Transparent"
                           Padding="15,10"
                           Margin="5,2"
                           CornerRadius="8"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToMySpots" />
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="40,*">
                            <Label Grid.Column="0"
                                   Text="📍"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            
                            <StackLayout Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalOptions="Center">
                                <Label Text="Mes Spots"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Text="Spots que vous avez créés"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>
                    </Frame>
                    
                    <!-- Favoris -->
                    <Frame BackgroundColor="Transparent"
                           BorderColor="Transparent"
                           Padding="15,10"
                           Margin="5,2"
                           CornerRadius="8"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToFavorites" />
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="40,*">
                            <Label Grid.Column="0"
                                   Text="⭐"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            
                            <StackLayout Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalOptions="Center">
                                <Label Text="Favoris"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Text="Vos spots préférés"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>
                    </Frame>
                    
                    <!-- Profil Section -->
                    <Label Text="Profil"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="15,15,15,5" />
                    
                    <!-- Profil -->
                    <Frame BackgroundColor="Transparent"
                           BorderColor="Transparent"
                           Padding="15,10"
                           Margin="5,2"
                           CornerRadius="8"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToProfile" />
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="40,*">
                            <Label Grid.Column="0"
                                   Text="👤"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            
                            <StackLayout Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalOptions="Center">
                                <Label Text="Profil"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Text="Votre profil utilisateur"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>
                    </Frame>
                    
                    <!-- Statistiques -->
                    <Frame BackgroundColor="Transparent"
                           BorderColor="Transparent"
                           Padding="15,10"
                           Margin="5,2"
                           CornerRadius="8"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToStats" />
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="40,*">
                            <Label Grid.Column="0"
                                   Text="📊"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            
                            <StackLayout Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalOptions="Center">
                                <Label Text="Statistiques"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Text="Vos statistiques de plongée"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>
                    </Frame>
                    
                    <!-- Administration Section -->
                    <Label Text="Administration"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="15,15,15,5" />
                    
                    <!-- Validation des Spots -->
                    <Frame BackgroundColor="Transparent"
                           BorderColor="Transparent"
                           Padding="15,10"
                           Margin="5,2"
                           CornerRadius="8"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToValidation" />
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="40,*">
                            <Label Grid.Column="0"
                                   Text="⚖️"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            
                            <StackLayout Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalOptions="Center">
                                <Label Text="Validation des Spots"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Text="Administration des spots"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>
                    </Frame>
                    
                    <!-- Logout Button -->
                    <Frame BackgroundColor="{StaticResource Accent}"
                           BorderColor="{StaticResource Accent}"
                           Padding="15,10"
                           Margin="15,20,15,15"
                           CornerRadius="8"
                           HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogout" />
                        </Frame.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="40,*">
                            <Label Grid.Column="0"
                                   Text="🚪"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            
                            <Label Grid.Column="1"
                                   Text="Déconnexion"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   Margin="10,0,0,0"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                    
                </StackLayout>
            </ScrollView>
        </DataTemplate>
    </Shell.FlyoutContentTemplate>

    <!-- Main Navigation Content - Correct Structure for Hamburger Menu -->
    <FlyoutItem Title="Carte" Route="map" FlyoutItemIsVisible="False">
        <Tab Title="Carte">
            <ShellContent
                Title="Carte"
                ContentTemplate="{DataTemplate map:MapPage}" />
        </Tab>
    </FlyoutItem>
        
    <!-- Hidden routes for navigation -->
    <ShellContent
        Title="Mes Spots"
        ContentTemplate="{DataTemplate spots:MySpotsPage}"
        Route="myspots"
        FlyoutItemIsVisible="False" />
        
    <ShellContent
        Title="Favoris"
        ContentTemplate="{DataTemplate favorites:FavoritesPage}"
        Route="favorites"
        FlyoutItemIsVisible="False" />
        
    <ShellContent
        Title="Profil"
        ContentTemplate="{DataTemplate profile:UserProfilePage}"
        Route="userprofile"
        FlyoutItemIsVisible="False" />
        
    <ShellContent
        Title="Statistiques"
        ContentTemplate="{DataTemplate profile:UserStatsPage}"
        Route="userstats"
        FlyoutItemIsVisible="False" />

    <!-- Modal Pages - Outside main navigation -->
    <!-- Add Spot Page Route - TEMPORAIREMENT DÉSACTIVÉ (ViewModels Entity Framework supprimés) -->
    <!--
    <ShellContent
        Title="Ajouter un Spot"
        ContentTemplate="{DataTemplate spots:AddSpotPage}"
        Route="addspot" />
    -->

    <!-- Spot Details Page Route -->
    <ShellContent
        Title="Détails du Spot"
        ContentTemplate="{DataTemplate spots:SpotDetailsPage}"
        Route="spotdetails" 
        FlyoutItemIsVisible="False" />

    <!-- Admin route - Hidden - Placeholder page for navigation -->
    <ShellContent
        Title="Validation des Spots"
        ContentTemplate="{DataTemplate spots:MySpotsPage}"
        Route="spotvalidation"
        FlyoutItemIsVisible="False" />

    <!-- Database Test route - Hidden - Placeholder page for navigation -->
    <ShellContent
        Title="Test Base de Données"
        ContentTemplate="{DataTemplate spots:MySpotsPage}"
        Route="databasetest"
        FlyoutItemIsVisible="False" />

    <!-- About route - Hidden -->
    <ShellContent
        Title="À Propos"
        ContentTemplate="{DataTemplate settings:AboutPage}"
        Route="about"
        FlyoutItemIsVisible="False" />

    <!-- Authentication routes - Hidden from flyout -->
    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate auth:CompleteLoginPage}"
        Route="login"
        FlyoutItemIsVisible="False" />

    <ShellContent
        Title="Inscription"
        ContentTemplate="{DataTemplate auth:RegistrationPage}"
        Route="register"
        FlyoutItemIsVisible="False" />

</Shell>
