<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SubExplore.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SubExplore"
    xmlns:map="clr-namespace:SubExplore.Views.Map"
    xmlns:spots="clr-namespace:SubExplore.Views.Spots"
    xmlns:favorites="clr-namespace:SubExplore.Views.Favorites"
    xmlns:profile="clr-namespace:SubExplore.Views.Profile"
    xmlns:admin="clr-namespace:SubExplore.Views.Admin"
    xmlns:auth="clr-namespace:SubExplore.Views.Auth"
    xmlns:settings="clr-namespace:SubExplore.Views.Settings"
    xmlns:controls="clr-namespace:SubExplore.Controls"
    xmlns:viewmodels="clr-namespace:SubExplore.ViewModels"
    xmlns:converters="clr-namespace:SubExplore.Helpers.Converters"
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" 
    Shell.ForegroundColor="{AppThemeBinding Light=Black, Dark=White}"
    Shell.TitleColor="{AppThemeBinding Light=Black, Dark=White}"
    FlyoutIcon="dotnet_bot.png"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
    FlyoutHeaderBehavior="CollapseOnScroll"
    Title="SubExplore"
    x:Name="AppShellRoot">
    
    <Shell.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BooleanMultiValueConverter x:Key="BooleanMultiValueConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- TEMPLATES FLYOUT TEMPORARILY DISABLED TO TEST HAMBURGER ICON -->
    <!--
    Shell.FlyoutHeaderTemplate and Shell.FlyoutContentTemplate removed temporarily
    to test if hamburger icon appears with default Shell flyout behavior
    -->

    <!-- Navigation Items with Standard FlyoutItem Structure -->
    <FlyoutItem Title="Carte" Icon="dotnet_bot.png">
        <ShellContent Route="map" ContentTemplate="{DataTemplate map:MapPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mes Spots" Icon="dotnet_bot.png">
        <ShellContent Route="myspots" ContentTemplate="{DataTemplate spots:MySpotsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Favoris" Icon="dotnet_bot.png">
        <ShellContent Route="favorites" ContentTemplate="{DataTemplate favorites:FavoritesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Profil" Icon="dotnet_bot.png">
        <ShellContent Route="userprofile" ContentTemplate="{DataTemplate profile:UserProfilePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Statistiques" Icon="dotnet_bot.png">
        <ShellContent Route="userstats" ContentTemplate="{DataTemplate profile:UserStatsPage}" />
    </FlyoutItem>

    <!-- Modal Pages - Outside main navigation -->
    <!-- Add Spot Page Route - TEMPORAIREMENT DÉSACTIVÉ (ViewModels Entity Framework supprimés) -->
    <!--
    <ShellContent
        Title="Ajouter un Spot"
        ContentTemplate="{DataTemplate spots:AddSpotPage}"
        Route="addspot" />
    -->

    <!-- Spot Details Page Route -->
    <ShellContent
        Title="Détails du Spot"
        ContentTemplate="{DataTemplate spots:SpotDetailsPage}"
        Route="spotdetails" 
        FlyoutItemIsVisible="False" />

    <!-- Admin route - Hidden - Placeholder page for navigation -->
    <ShellContent
        Title="Validation des Spots"
        ContentTemplate="{DataTemplate spots:MySpotsPage}"
        Route="spotvalidation"
        FlyoutItemIsVisible="False" />

    <!-- Database Test route - Hidden - Placeholder page for navigation -->
    <ShellContent
        Title="Test Base de Données"
        ContentTemplate="{DataTemplate spots:MySpotsPage}"
        Route="databasetest"
        FlyoutItemIsVisible="False" />

    <!-- About route - Hidden -->
    <ShellContent
        Title="À Propos"
        ContentTemplate="{DataTemplate settings:AboutPage}"
        Route="about"
        FlyoutItemIsVisible="False" />

    <!-- Authentication routes - Hidden from flyout -->
    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate auth:CompleteLoginPage}"
        Route="login"
        FlyoutItemIsVisible="False" />

    <ShellContent
        Title="Inscription"
        ContentTemplate="{DataTemplate auth:RegistrationPage}"
        Route="register"
        FlyoutItemIsVisible="False" />

</Shell>
